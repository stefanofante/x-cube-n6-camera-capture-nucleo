{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "cubeProgBin",
            "type": "promptString",
            "description": "Path to STM32_Programmer_CLI.exe (default installation path)",
            "default": "C:/Program Files/STMicroelectronics/STM32Cube/STM32CubeProgrammer/bin/STM32_Programmer_CLI.exe"
        },
        {
            "id": "signingToolBin",
            "type": "promptString",
            "description": "Path to STM32_SigningTool_CLI.exe (default installation path)",
            "default": "C:/Program Files/STMicroelectronics/STM32Cube/STM32CubeProgrammer/bin/STM32_SigningTool_CLI.exe"
        },
        {
            "id": "externalLoader",
            "type": "pickString",
            "description": "External loader for the onboard Octo-SPI NOR",
            "options": [
                "MX25UM51245G_STM32N6570-NUCLEO.stldr",
                "MX66UW1G45G_STM32N6570-DK.stldr"
            ],
            "default": "MX25UM51245G_STM32N6570-NUCLEO.stldr"
        },
        {
            "id": "fsblBin",
            "type": "promptString",
            "description": "Path to the FSBL binary built from Tools/FSBL",
            "default": "${workspaceFolder}/Tools/FSBL/build/FSBL.bin"
        }
    ],
    "tasks": [
        {
            "label": "N6: Configure App",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "N6: Build App",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Debug",
                "--parallel",
                "4"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "N6: Configure App"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "label": "N6: Configure FSBL",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}/Tools/FSBL",
                "-B",
                "${workspaceFolder}/Tools/FSBL/build",
                "-G",
                "Ninja",
                "--toolchain",
                "${workspaceFolder}/cmake/gcc-arm-none-eabi.cmake",
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "N6: Build FSBL",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/Tools/FSBL/build"
            ],
            "dependsOn": [
                "N6: Configure FSBL"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "group": "build"
        },
        {
            "label": "N6: Sign App",
            "type": "shell",
            "command": "${input:signingToolBin}",
            "args": [
                "-bin",
                "${workspaceFolder}/build/Debug/x-cube-n6-camera-capture-nucleo.bin",
                "-nk",
                "-t",
                "ssbl",
                "-hv",
                "2.3",
                "-o",
                "${workspaceFolder}/build/Debug/x-cube-n6-camera-capture-nucleo_signed.bin"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "dependsOn": [
                "N6: Build App"
            ]
        },
        {
            "label": "N6: Sign FSBL",
            "type": "shell",
            "command": "${input:signingToolBin}",
            "args": [
                "-bin",
                "${input:fsblBin}",
                "-nk",
                "-t",
                "fsbl",
                "-hv",
                "2.3",
                "-o",
                "${workspaceFolder}/Tools/FSBL/build/fsbl_signed.bin"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "dependsOn": [
                "N6: Build FSBL"
            ]
        },
        {
            "label": "N6: Program FSBL",
            "type": "shell",
            "command": "${input:cubeProgBin}",
            "args": [
                "-c",
                "port=SWD",
                "mode=HOTPLUG",
                "-el",
                "${input:externalLoader}",
                "-hardRst",
                "-w",
                "${workspaceFolder}/Tools/FSBL/build/fsbl_signed.bin",
                "0x70000000"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "N6: Program App",
            "type": "shell",
            "command": "${input:cubeProgBin}",
            "args": [
                "-c",
                "port=SWD",
                "mode=HOTPLUG",
                "-el",
                "${input:externalLoader}",
                "-hardRst",
                "-w",
                "${workspaceFolder}/build/Debug/x-cube-n6-camera-capture-nucleo_signed.bin",
                "0x70100000"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "N6: Build + Sign + Program App",
            "dependsOrder": "sequence",
            "dependsOn": [
                "N6: Sign App",
                "N6: Program App"
            ],
            "problemMatcher": []
        },
        {
            "label": "N6: Full Program (FSBL + App)",
            "dependsOrder": "sequence",
            "dependsOn": [
                "N6: Build FSBL",
                "N6: Sign FSBL",
                "N6: Sign App",
                "N6: Program FSBL",
                "N6: Program App"
            ],
            "problemMatcher": []
        },
        {
            "label": "N6: Erase External Flash",
            "type": "shell",
            "command": "${input:cubeProgBin}",
            "args": [
                "-c",
                "port=SWD",
                "mode=HOTPLUG",
                "-el",
                "${input:externalLoader}",
                "-hardRst",
                "-e",
                "all"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
